#!/bin/sh
export SSH_AUTH_SOCK="/run/user/$(id -u)/gnupg/S.gpg-agent.ssh"
hub=lovelace
local_host=$(hostname -s)
if [ "$local_host" != "$hub" ]; then
    workstation=$local_host
    case "$workstation" in *[!A-Za-z0-9_-]*|'') exit 2;; esac
    runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    local_socket=$runtime/fleet-workstation-client-$$.sock
    remote_socket=/run/user/$(id -u)/fleet-workstation-$workstation.sock
    python -c 'import sys; from agent_fleet.workstation import serve; serve(sys.argv[1])' "$local_socket" &
    helper=$!
    trap 'kill "$helper" 2>/dev/null; wait "$helper" 2>/dev/null; rm -f "$local_socket"' EXIT
    i=0
    while [ ! -S "$local_socket" ]; do
        i=$((i + 1))
        [ "$i" -lt 100 ] || exit 1
        sleep .05
    done
    ssh -T -o BatchMode=yes "$hub" \
        "if [ -S '$remote_socket' ]; then unlink '$remote_socket'; elif [ -e '$remote_socket' ]; then exit 1; fi" ||
        exit
    ssh -tt -o BatchMode=yes -o ExitOnForwardFailure=yes \
        -o StreamLocalBindUnlink=yes -o StreamLocalBindMask=0177 \
        -R "$remote_socket:$local_socket" \
        "$hub" fleet-muster --workstation "$workstation"
    exit $?
fi
if [ "$#" -eq 0 ]; then
    workstation=$local_host
    runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    local_socket=$runtime/fleet-workstation-$workstation.sock
    python -c 'import sys; from agent_fleet.workstation import serve; serve(sys.argv[1])' "$local_socket" &
    helper=$!
    trap 'kill "$helper" 2>/dev/null; wait "$helper" 2>/dev/null; rm -f "$local_socket"' EXIT
    i=0
    while [ ! -S "$local_socket" ]; do
        i=$((i + 1))
        [ "$i" -lt 100 ] || exit 1
        sleep .05
    done
    set -- --workstation "$workstation"
fi
if [ "$1" = --workstation ]; then
    case "$2" in *[!A-Za-z0-9_-]*|'') exit 2;; esac
    workstation=$2
elif [ "$#" -ne 0 ]; then
    exit 2
fi
systemctl --user start fleet.service || exit
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-fleet/fleet.sock
i=0
while [ ! -S "$runtime" ]; do
    i=$((i + 1))
    [ "$i" -lt 100 ] || { echo "fleet service did not become ready" >&2; exit 1; }
    sleep .05
done
if ! tmux has-session -t fleet@muster 2>/dev/null; then
    tmux new-session -d -s fleet@muster -n live 'exec /usr/lib/agent-fleet/ui items | exec /usr/lib/agent-fleet/ui muster'
fi
tmux set-option -t fleet@muster mouse off
tmux list-windows -t fleet@muster -F '#{window_name}' | grep -qx history ||
    tmux new-window -d -t fleet@muster -n history 'exec /usr/lib/agent-fleet/ui history-rows | exec /usr/lib/agent-fleet/ui history-ui'
[ -z "$workstation" ] || tmux set-option -t fleet@muster @fleet_workstation "$workstation"
if [ -z "$helper" ]; then
    exec tmux -u attach-session -t fleet@muster
fi
tmux -u attach-session -t fleet@muster
