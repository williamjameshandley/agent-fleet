#!/usr/bin/python3
"""Account-limit readers for the Fleet header."""

import json
import os
import select
import subprocess
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime
from email.utils import parsedate_to_datetime
from pathlib import Path

CODEX_APP_SERVER = ("codex", "app-server", "--stdio")


def progress(percent, width=16):
    full = round(percent * width / 100)
    return "#" * full + "-" * (width - full)


def field(name, used=0, reset=None):
    if reset:
        fmt = "%a %d %H:%M" if name == "7d" else "%H:%M"
        reset_at = f"@{time.strftime(fmt, time.localtime(reset))}"
    else:
        reset_at = "/0h"
    width = 10 if name == "5h" else 0
    return f"{name:<2} [{progress(used)}] {used:>3g}%{reset_at:<{width}}"


def claude():
    auth = json.loads((Path.home() / ".claude/.credentials.json").read_text())
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={"Authorization": f"Bearer {auth['claudeAiOauth']['accessToken']}",
                 "anthropic-beta": "oauth-2025-04-20"})
    limits = json.load(urllib.request.urlopen(req, timeout=10))["limits"]
    fields = {}
    for limit in limits:
        if limit["kind"] == "session":
            name = "5h"
        elif limit["kind"] == "weekly_all":
            name = "7d"
        elif limit["kind"] == "weekly_scoped":
            continue
        else:
            raise ValueError(f"unknown limit kind {limit['kind']!r}")
        value = limit["resets_at"]
        reset = (datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
                 if value else None)
        fields[name] = field(name, limit["percent"], reset)
    return "  ".join(fields[name] for name in ("5h", "7d"))


def response(process, request_id, deadline, buffer):
    while True:
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            message = json.loads(line)
            if message.get("id") == request_id:
                if "error" in message:
                    raise ValueError(f"Codex app server: {message['error']}")
                return message["result"], buffer
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([process.stdout], [], [], remaining)[0]:
            raise TimeoutError("Codex app server did not respond")
        chunk = os.read(process.stdout.fileno(), 65536)
        if not chunk:
            raise ValueError("Codex app server closed without a response")
        buffer += chunk


def send(process, message):
    process.stdin.write((json.dumps(message, separators=(",", ":")) + "\n").encode())
    process.stdin.flush()


def reap(process, timeout):
    if not process.stdin.closed:
        try:
            process.stdin.close()
        except BrokenPipeError:
            pass
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=min(1, max(0.1, timeout)))
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def codex(command=CODEX_APP_SERVER, timeout=10):
    process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    deadline = time.monotonic() + timeout
    buffer = b""
    try:
        send(process, {"id": 1, "method": "initialize", "params": {
            "clientInfo": {"name": "fleet", "title": "Fleet", "version": "0.3"}}})
        _, buffer = response(process, 1, deadline, buffer)
        send(process, {"method": "initialized"})
        send(process, {"id": 2, "method": "account/rateLimits/read", "params": {}})
        result, buffer = response(process, 2, deadline, buffer)
        limits = result["rateLimits"]
        process.stdin.close()
        try:
            process.wait(timeout=max(0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            raise TimeoutError("Codex app server did not exit") from None
    finally:
        reap(process, timeout)
    windows = {"5h": field("5h"), "7d": field("7d")}
    for quota in (limits.get("primary"), limits.get("secondary")):
        if quota is None:
            continue
        minutes = quota["windowDurationMins"]
        if minutes == 300:
            name = "5h"
        elif minutes == 10080:
            name = "7d"
        else:
            raise ValueError(f"unknown Codex limit window {minutes}m")
        windows[name] = field(name, quota["usedPercent"], quota["resetsAt"])
    return "  ".join(windows[name] for name in ("5h", "7d"))


def main():
    readers = {"claude": claude, "codex": codex}
    if len(sys.argv) != 2 or sys.argv[1] not in readers:
        sys.exit("usage: fleet-usage claude|codex")
    try:
        print(readers[sys.argv[1]]())
    except urllib.error.HTTPError as e:
        retry = e.headers.get("Retry-After")
        if retry and retry.isdigit():
            retry_at = int(time.time()) + int(retry)
        elif retry:
            retry_at = int(parsedate_to_datetime(retry).timestamp())
        else:
            retry_at = None
        suffix = f" retry-at={retry_at}" if retry_at else ""
        sys.exit(f"fleet-usage: {sys.argv[1]}: HTTP {e.code}{suffix}")
    except (OSError, KeyError, TypeError, ValueError) as e:
        sys.exit(f"fleet-usage: {sys.argv[1]}: {e}")


if __name__ == "__main__":
    main()
