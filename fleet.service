[Unit]
Description=Agent Fleet central event collector
ConditionHost=lovelace
After=network-online.target

[Service]
Type=simple
UnsetEnvironment=LOOP_SOCKET LOOP_CAPABILITIES
ExecStart=/usr/bin/python -c 'import asyncio; from agent_fleet.daemon import Fleet; asyncio.run(Fleet().serve())'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-fleet-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
