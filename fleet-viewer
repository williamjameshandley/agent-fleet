#!/bin/sh
export SSH_AUTH_SOCK="/run/user/$(id -u)/gnupg/S.gpg-agent.ssh"
tmux() { /usr/bin/tmux -L agent-fleet-ui "$@"; }
detach_displays() {
    tmux list-clients -t "fleet@$slot" -f '#{==:#{client_control_mode},0}' \
        -F '#{client_name}' 2>/dev/null | while IFS= read -r client; do
        [ -n "$client" ] && tmux detach-client -t "$client"
    done
}
if [ "${1:-}" = --destroy ]; then
    slot=${2:-}
    case "$slot" in *[!A-Za-z0-9_-]*|'') exit 2;; esac
    if [ "$(hostname -s)" != lovelace ]; then
        exec ssh -T -o BatchMode=yes lovelace fleet-viewer --destroy "$slot"
    fi
    runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-fleet
    if tmux has-session -t "fleet@$slot" 2>/dev/null; then
        reply=$(printf 'SHUTDOWN\n' | /usr/bin/nc -U "$runtime/viewer-$slot.sock") || exit
        if [ "$reply" != OK ]; then
            printf '%s\n' "${reply:-viewer shutdown returned no response}" >&2
            exit 1
        fi
        tmux kill-session -t "fleet@$slot"
    fi
    exit
fi
slot=${1:-main}
case "$slot" in *[!A-Za-z0-9_-]*|'') exit 2;; esac
if [ "$(hostname -s)" != lovelace ]; then
    exec ssh -tt -o BatchMode=yes lovelace fleet-viewer "$slot"
fi
if [ "$slot" = main ]; then
    if tmux has-session -t fleet@main 2>/dev/null && ! printf 'STATUS\n' | /usr/bin/nc -U "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-fleet/viewer-main.sock" >/dev/null 2>&1; then
        tmux kill-session -t fleet@main
    fi
    if ! tmux has-session -t fleet@main 2>/dev/null; then
        tmux new-session -d -s fleet@main 'exec sleep infinity'
        tmux respawn-pane -k -t '=fleet@main:' "exec env -u TMUX -u TMUX_PANE python -c 'from agent_fleet.viewer import serve; serve(\"main\")'"
        tmux set-option -t fleet@main prefix None
        tmux set-option -t fleet@main prefix2 None
        tmux set-option -t fleet@main window-size latest
    fi
    tmux set-option -t fleet@main status-position top
    tmux set-option -t fleet@main status on
    tmux set-option -t fleet@main mouse on
    detach_displays
    exec /usr/bin/tmux -N -L agent-fleet-ui -u attach-session -t fleet@main
fi
if tmux has-session -t "fleet@$slot" 2>/dev/null && ! printf 'STATUS\n' | /usr/bin/nc -U "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-fleet/viewer-$slot.sock" >/dev/null 2>&1; then
    tmux kill-session -t "fleet@$slot"
fi
if ! tmux has-session -t "fleet@$slot" 2>/dev/null; then
    tmux new-session -d -s "fleet@$slot" 'exec sleep infinity'
    tmux respawn-pane -k -t "=fleet@$slot:" "exec env -u TMUX -u TMUX_PANE python -c 'import sys; from agent_fleet.viewer import serve; serve(sys.argv[1])' '$slot'"
    tmux set-option -t "fleet@$slot" prefix None
    tmux set-option -t "fleet@$slot" prefix2 None
    tmux set-option -t "fleet@$slot" window-size latest
fi
tmux set-option -t "fleet@$slot" status off
tmux set-option -t "fleet@$slot" mouse on
detach_displays
exec /usr/bin/tmux -N -L agent-fleet-ui -u attach-session -t "fleet@$slot"
