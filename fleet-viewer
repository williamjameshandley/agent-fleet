#!/bin/sh
tmux() { /usr/bin/tmux -L agent-fleet-ui "$@"; }
slot=${1:-main}
case "$slot" in *[!A-Za-z0-9_-]*|'') exit 2;; esac
if [ "$slot" = main ]; then
    if [ "$(hostname -s)" != lovelace ]; then
        exec ssh -tt -o BatchMode=yes lovelace fleet-viewer main
    fi
    if tmux has-session -t fleet@main 2>/dev/null && ! printf 'STATUS\n' | /usr/bin/nc -U "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-fleet/viewer-main.sock" >/dev/null 2>&1; then
        tmux kill-session -t fleet@main
    fi
    if ! tmux has-session -t fleet@main 2>/dev/null; then
        tmux new-session -d -s fleet@main "exec python -c 'from agent_fleet.viewer import serve; serve(\"main\")'"
        tmux set-option -t fleet@main prefix None
        tmux set-option -t fleet@main prefix2 None
        tmux set-option -t fleet@main window-size latest
    fi
    tmux set-option -t fleet@main status off
    tmux set-option -t fleet@main mouse on
    exec /usr/bin/tmux -N -L agent-fleet-ui -u attach-session -t fleet@main
fi
exec python -c 'import sys; from agent_fleet.viewer import serve; serve(sys.argv[1])' "$slot"
