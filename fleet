#!/usr/bin/env python3
import sys

if len(sys.argv) >= 2 and sys.argv[1] == "preview":
    import argparse

    from agent_fleet.daemon import preview

    parser = argparse.ArgumentParser(prog="fleet preview")
    parser.add_argument("key")
    parser.add_argument("columns", type=int, nargs="?", default=0)
    parser.add_argument("lines", type=int, nargs="?", default=0)
    args = parser.parse_args(sys.argv[2:])
    try:
        print(preview(args.key, args.columns, args.lines), end="")
    except RuntimeError as error:
        if str(error).startswith("session disappeared: ") or str(error).endswith(
            " is disconnected; refusing action"
        ):
            raise SystemExit(str(error)) from None
        raise
else:
    from agent_fleet.cli import main

    main()
